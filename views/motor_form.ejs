<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Motor Insurance Quote</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>Motor Insurance</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/motor">Motor</a>
      <a href="/health">Health</a>
    </nav>
  </header>

  <main>
    <h2>Get a Quote</h2>
    <form action="/motor/quote" method="POST">
      <label for="vehicleType">Vehicle Type</label>
      <select id="vehicleType" name="vehicleType" required>
        <option value="car">Car</option>
        <option value="motorcycle">Motorcycle</option>
      </select>

      <label for="make">Make</label>
      <input type="text" id="make" name="make" required>

      <label for="model">Model</label>
      <input type="text" id="model" name="model" required>

      <label for="year">Manufacture Year</label>
      <input type="number" id="year" name="year" min="1980" max="<%= new Date().getFullYear() %>" required>

      <label for="coverType">Cover Type</label>
      <select id="coverType" name="coverType" required>
        <option value="thirdparty">Third Party</option>
        <option value="comprehensive">Comprehensive</option>
      </select>

      <button type="submit">Get Quote</button>
    </form>
  </main>

  <footer>
    &copy; <%= new Date().getFullYear() %> General Insurance Co.
  </footer>
</body>
</html>