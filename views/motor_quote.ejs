<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Motor Insurance Quote</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>Motor Insurance</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/motor">Motor</a>
      <a href="/health">Health</a>
    </nav>
  </header>

  <main>
    <h2>Your Quote</h2>
    <p class="quote-number">Premium Amount: <strong>₹<%= premium %></strong></p>

    <form action="/motor/buy" method="POST">
      <% for (let key in data) { %>
        <input type="hidden" name="<%= key %>" value="<%= data[key] %>">
      <% } %>
      <input type="hidden" name="premium" value="<%= premium %>">
      <button type="submit">Buy Now</button>
    </form>
  </main>

  <footer>
    &copy; <%= new Date().getFullYear() %> General Insurance Co.
  </footer>
</body>
</html>